ce=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="46" y="84" width="1408" height="52" as="geometry"/></mxCell><mxCell id="footer" value="Mingle  |  Application main 7764f0e  |  Prepared 14 Nov 2026  |  AI-assisted design documentation" style="fontFamily=Comic Sans MS;fontSize=18;fontColor=#27313D;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="44" y="1038" width="1412" height="28" as="geometry"/></mxCell><mxCell id="eligible" value="Eligible people&#xa;No connection" style="fontFamily=Comic Sans MS;fontSize=18;fontColor=#27313D;whiteSpace=wrap;html=0;rounded=0;strokeColor=#677584;fillColor=#FFFFFF;strokeWidth=1.4;spacing=12;rounded=1;arcSize=18;fillColor=#EAF2FA;" vertex="1" parent="1"><mxGeometry x="100" y="230" width="310" height="118" as="geometry"/></mxCell><mxCell id="one-like" value="One-sided LIKE&#xa;No conversation yet" style="fontFamily=Comic Sans MS;fontSize=18;fontColor=#27313D;whiteSpace=wrap;html=0;rounded=0;strokeColor=#677584;fillColor=#FFFFFF;strokeWidth=1.4;spacing=12;rounded=1;arcSize=18;fillColor=#EAF2FA;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="330" height="118" as="geometry"/></mxCell><mxCell id="active" value="Active connection&#xa;Both members may chat" style="fontFamily=Comic Sans MS;fontSize=18;fontColor=#27313D;whiteSpace=wrap;html=0;rounded=0;strokeColor=#677584;fillColor=#FFFFFF;strokeWidth=1.4;spacing=12;rounded=1;arcSize=18;fillColor=#E8F4EF;" vertex="1" parent="1"><mxGeometry x="1080" y="230" width="330" height="118" as="geometry"/></mxCell><mxCell id="skip" value="SKIP recorded&#xa;Excluded from discovery" style="fontFamily=Comic Sans MS;fontSize=18;fontColor=#27313D;whiteSpace=wrap;html=0;rounded=0;strokeColor=#677584;fillColor=#FFFFFF;strokeWidth=1.4;spacing=12;rounded=1;arcSize=18;fillColor=#F1F3F4;" vertex="1" parent="1"><mxGeometry x="100" y="570" width="310" height="118" as="geometry"/></mxCell><mxCell id="closed" value="Ended connection&#xa;Messages unavailable to both" style="fontFamily=Comic Sans MS;fontSize=18;fontColor=#27313D;whiteSpace=wrap;html=0;rounded=0;strokeColor=#677584;fillColor=#FFFFFF;strokeWidth=1.4;spacing=12;rounded=1;arcSize=18;fillColor=#FCEBE5;" vertex="1" parent="1"><mxGeometry x="1080" y="570" width="330" height="118" as="geometry"/></mxCell><mxCell id="like" value="LIKE" style="fontFamily=Comic Sans MS;fontSize=18;fontColor=#27313D;edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#677584;strokeWidth=1.5;endArrow=open;endFill=0;endSize=8;dashed=0;labelBackgroundColor=#FFFFFF;fontSize=16;" edge="1" parent="1" source="eligible" target="one-like"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mutual" value="reciprocal LIKE" style="fontFamily=Comic Sans MS;fontSize=18;fontColor=#27313D;edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#677584;strokeWidth=1.5;endArrow=open;endFill=0;endSize=8;dashed=0;labelBackgroundColor=#FFFFFF;fontSize=16;" edge="1" parent="1" source="one-like" target="active"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="choose-skip" value="SKIP" style="fontFamily=Comic Sans MS;fontSize=18;fontColor=#27313D;edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#677584;strokeWidth=1.5;endArrow=open;endFill=0;endSize=8;dashed=0;labelBackgroundColor=#FFFFFF;fontSize=16;" edge="1" parent="1" source="eligible" target="skip"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reset-skip" value="Reset skips" style="fontFamily=Comic Sans MS;fontSize=18;fontColor=#27313D;html=0;strokeColor=#677584;strokeWidth=1.5;endArrow=open;endFill=0;endSize=8;startArrow=none;dashed=0;rounded=0;labelBackgroundColor=#FFFFFF;fontSize=16;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="629" as="sourcePoint"/><